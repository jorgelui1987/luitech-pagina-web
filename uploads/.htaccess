# Carpeta de archivos subidos por el panel (fotos y firmas del acta).
# Solo se sirven imágenes estáticas: aquí NUNCA debe ejecutarse un script.
Options -Indexes -ExecCGI

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phps .phar .cgi .pl .py .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phps .phar .cgi .pl .py .sh

<FilesMatch "\.(?i:php|phtml|php3|php4|php5|php7|phps|phar|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>
