# Seguridad básica para el sitio de Luitech (Apache - Laragon)
Options -Indexes

# Un solo dominio canónico: todo entra por https://www.tallerluitech.fun
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} !^www\. [NC]
    RewriteRule ^ https://www.tallerluitech.fun%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
</IfModule>

# Nunca exponer respaldos ni archivos sensibles
<FilesMatch "\.(sql|log|md|lock)$">
    Require all denied
</FilesMatch>
