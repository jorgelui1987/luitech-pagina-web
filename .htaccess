# Seguridad básica para el sitio de Luitech (Apache - Laragon)
Options -Indexes

# Un solo dominio canónico: todo entra por https://www.tallerluitech.fun
# Nota: NO se fuerza HTTPS aqui — este hosting entrega el SSL por proxy y la
# variable %HTTPS siempre queda "off", lo que causaba un bucle infinito.
# Por eso tambien la redireccion es 302 (temporal, no queda en cache).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} !^www\. [NC]
    RewriteRule ^ https://www.tallerluitech.fun%{REQUEST_URI} [R=302,L]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # Permissions-Policy: el propio sitio SÍ puede pedir la cámara (escáner
    # del POS) y la geolocalización; los terceros no. OJO: camera=() (lista
    # vacía) bloqueaba la cámara por completo y Chrome NUNCA mostraba el
    # aviso de permiso — ni en incognito ni desde el candado.
    Header set Permissions-Policy "geolocation=(self), microphone=(), camera=(self)"
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; worker-src 'self' blob: https://cdnjs.cloudflare.com; connect-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
    # Las páginas y el service worker SIEMPRE se revalidan: en el teléfono
    # nunca se sirve una versión vieja guardada por el navegador.
    <FilesMatch "\.(html)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "^(sw\.js)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Nunca exponer respaldos ni archivos sensibles
<FilesMatch "\.(sql|log|md|lock)$">
    Require all denied
</FilesMatch>
